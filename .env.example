# Required: generate independently for each installation. Keep unchanged on upgrades/reset.
PAYLOAD_SECRET=
# Public canonical URL for links. Use your existing URL when upgrading.
NEXT_PUBLIC_SITE_URL=https://your-worker.your-subdomain.workers.dev
# Required for scheduled application processing; random secret of at least 32 characters.
FORM_JOB_TOKEN=
# Required for protected release probes; random secret of at least 32 characters.
RELEASE_OPERATOR_TOKEN=
# Non-secret Worker name; configure with the separate OPERATIONS D1 binding.
RELEASE_TARGET=your-worker
# Optional test-mode payments. Without both secrets, payment integration is unavailable.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Keep external CRM email sending disabled until its provider is deliberately configured.
CRM_EMAIL_ENVIRONMENT=test
CRM_EMAIL_LIVE_SEND_ENABLED=false
CONTENT_WORKSPACE_ENABLED=true
ORGANIZATION_ADMIN_ENABLED=true
# One-time install/recovery commands only; never upload these as Worker secrets.
VORTI_BOOTSTRAP_PASSWORD=
VORTI_RECOVERY_PASSWORD=
# Local test/build only: absolute native Linux path under .wrangler; omit in production.
# DESIGN_CORE_TEST_PERSIST_PATH=/build/.wrangler/local/v3
