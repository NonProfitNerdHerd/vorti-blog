{
  "name": "@design-system/payload-design-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hero-board": {
      "types": "./dist/hero-board/index.d.ts",
      "default": "./dist/hero-board/index.js"
    },
    "./hero-board/registration": {
      "types": "./dist/hero-board/registration.d.ts",
      "default": "./dist/hero-board/registration.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/ui": "^3.87.0",
    "payload": "^3.87.0",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react-dom": "19.2.6",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
