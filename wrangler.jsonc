{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "forms-worker.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "CRM_JOB_QUEUE", "queue": "vorti-crm-jobs" }],
    "consumers": [{ "queue": "vorti-crm-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 2, "max_retries": 5 }],
  },
  "name": "vorti-blog",
  "vars": {
    "CONTENT_WORKSPACE_ENABLED": "true",
    "CRM_EMAIL_LIVE_SEND_ENABLED": "false",
    "ORGANIZATION_ADMIN_ENABLED": "true",
  },
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "2e5282ec-dc28-4408-bb39-bf60a2bf3311",
      "database_name": "vorti-blog-reset-20261025",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    { "binding": "WORKSPACE_FILES", "bucket_name": "vorti-workspace-reset-20261025" },
    {
      "binding": "R2",
      "bucket_name": "vorti-blog-reset-20261025","preview_bucket_name": "vorti-blog-reset-20261025",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
