{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "forms-worker.ts",
  "name": "vorti-blog-local-test",
  "queues": {
    "producers": [{ "binding": "CRM_JOB_QUEUE", "queue": "vorti-crm-local-test" }],
    "consumers": [{ "queue": "vorti-crm-local-test", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 2, "max_retries": 5 }],
  },
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "CRM_EMAIL_ENVIRONMENT": "test", "CRM_EMAIL_LIVE_SEND_ENABLED": "false", "CONTENT_WORKSPACE_ENABLED": "true", "ORGANIZATION_ADMIN_ENABLED": "true" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "D1",
    "database_name": "vorti-blog-local-test",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "remote": false
  }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "vorti-blog-local-test" }, { "binding": "WORKSPACE_FILES", "bucket_name": "vorti-workspace-private-local-test" }]
}
